# Внешний URL отдельной Render Postgres. Не используйте БД проекта NOMAD.
DATABASE_URL=postgresql://user:password@host/database

# Код квартального запуска. Для нового опроса поменяйте значение и сделайте redeploy.
SURVEY_CYCLE=2026-Q3

# ИИ: Groq основной, NVIDIA резервный. Достаточно настроить хотя бы один.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1
NVIDIA_API_KEY=
NVIDIA_MODEL=openai/gpt-oss-120b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
